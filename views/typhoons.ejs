<%- include('partials/header') %>
<h1 class="pt">颱風消息</h1>
<section class="panel"><table class="data">
<thead><tr><th>名稱</th><th>編號</th><th>狀態</th><th>中心位置</th><th>氣壓 hPa</th><th>最大風速 / 陣風 m/s</th><th>移動</th><th>更新</th></tr></thead><tbody>
<% if (!list.length) { %><tr><td colspan="8" class="empty">目前沒有颱風資料</td></tr><% } %>
<% list.forEach(t => { %><tr><td><b><%= t.name %></b><%= t.active ? '' : '（過去）' %></td><td><%= t.intl_no || '—' %></td><td><%= t.status || '—' %></td>
<td><%= f.num(t.lat) %>°N <%= f.num(t.lon) %>°E</td><td><%= f.num(t.pressure) %></td><td><%= f.num(t.max_wind) %> / <%= f.num(t.gust) %></td>
<td><%= t.heading || '—' %> <%= f.num(t.speed, ' km/h') %></td><td><%= f.dt(t.updated_at) %></td></tr><% }) %>
</tbody></table></section>
<%- include('partials/footer') %>
