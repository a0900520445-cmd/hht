<%- include('partials/header') %>
<% if (item) { %>
<article class="panel"><h1><%= item.title %></h1><p class="meta"><%= item.category || '' %>　<%= f.dt(item.published_at) %></p>
<div class="prose"><%= item.content %></div><p class="more"><a href="/news">« 返回列表</a></p></article>
<% } else { %>
<h1 class="pt">最新消息</h1>
<section class="panel"><ul class="list"><% if (!list.length) { %><li class="empty">無資料</li><% } %>
<% list.forEach(n => { %><li><a href="/news/<%= n.id %>"><%= n.title %></a><small><%= n.category || '' %>　<%= f.dt(n.published_at) %></small></li><% }) %></ul></section>
<% } %>
<%- include('partials/footer') %>
