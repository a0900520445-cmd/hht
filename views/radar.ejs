<%- include('partials/header') %>
<div class="ph"><h1 class="pt">雷達回波</h1><span class="rtime" id="rtime"></span></div>
<section class="panel radar">
  <div id="map"></div>
  <div class="rctl"><button type="button" id="rplay" class="rbtn">暫停</button><input type="range" id="rslide" min="0" value="0"><span class="rleg">弱 <i></i> 強</span></div>
  <p class="meta">雷達資料來源：RainViewer，僅供參考，非官方觀測。</p>
</section>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script type="application/json" id="locs"><%- JSON.stringify(locations).replace(/</g, '\\u003c') %></script>
<script>
(async () => {
  const map = L.map('map', { zoomControl: true }).setView([23.7, 121], 7);
  L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', { maxZoom: 12, attribution: '© OpenStreetMap © CARTO' }).addTo(map);
  JSON.parse(document.getElementById('locs').textContent).forEach(l => l.lat && L.circleMarker([l.lat, l.lon], { radius: 5, color: '#145da0', weight: 2, fillColor: '#fff', fillOpacity: 1 }).bindTooltip(l.name).addTo(map));
  try {
    const d = await (await fetch('https://api.rainviewer.com/public/weather-maps.json')).json();
    const frames = [...d.radar.past, ...(d.radar.nowcast || [])];
    const layers = frames.map(f => L.tileLayer(`${d.host}${f.path}/256/{z}/{x}/{y}/2/1_1.png`, { opacity: 0, maxNativeZoom: 7, maxZoom: 12 }).addTo(map));
    const slide = document.getElementById('rslide'), rt = document.getElementById('rtime'), btn = document.getElementById('rplay');
    slide.max = frames.length - 1; let i = d.radar.past.length - 1, timer;
    const show = n => { layers[i].setOpacity(0); i = n; layers[i].setOpacity(.75); slide.value = i;
      rt.textContent = new Date(frames[i].time * 1000).toLocaleString('zh-TW', { hour12: false }) + (i >= d.radar.past.length ? '（預測）' : ''); };
    const play = () => { timer = setInterval(() => show((i + 1) % frames.length), 700); btn.textContent = '暫停'; };
    btn.onclick = () => timer ? (clearInterval(timer), timer = null, btn.textContent = '播放') : play();
    slide.oninput = () => { clearInterval(timer); timer = null; btn.textContent = '播放'; show(+slide.value); };
    show(i); play();
  } catch (e) { document.getElementById('rtime').textContent = '雷達資料暫時無法載入'; }
})();
</script>
<%- include('partials/footer') %>
