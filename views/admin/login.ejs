<!doctype html><html lang="zh-Hant"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>管理登入 | <%= site.name %></title><link rel="stylesheet" href="/css/admin.css"></head>
<body class="login"><form method="post" action="/admin/login" class="box">
<h1><%= site.name %></h1><p>後台管理系統</p>
<% if (error) { %><div class="err"><%= error %></div><% } %>
<label>帳號<input name="username" autocomplete="username" required autofocus></label>
<label>密碼<input type="password" name="password" autocomplete="current-password" required></label>
<button>登入</button><a href="/">← 回前台</a></form></body></html>
