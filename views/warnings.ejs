<%- include('partials/header') %>
<h1 class="pt">天氣警特報</h1>
<% if (!list.length) { %><p class="empty">目前沒有警特報</p><% } %>
<% list.forEach(w => { %>
<article class="panel warn lv-<%= w.level %>">
  <h2><span class="tag"><%= w.level %></span> <%= w.title %> <% if (!w.active) { %><em>（已解除）</em><% } %></h2>
  <p class="meta"><%= w.type %>　發布 <%= f.dt(w.issued_at) %><% if (w.expires_at) { %>　預計解除 <%= f.dt(w.expires_at) %><% } %></p>
  <% if (w.areas) { %><p><b>影響地區：</b><%= w.areas %></p><% } %>
  <p><%= w.content %></p>
</article>
<% }) %>
<%- include('partials/footer') %>
